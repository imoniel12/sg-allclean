SECRET_KEY=replace-with-a-long-random-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DATABASE_PATH=
ADMIN_BASE_PATH=/portal-access
SESSION_HTTPS_ONLY=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
ROBOTS_DISALLOW_ALL=false

# Replace and verify before enabling email delivery. Saved inquiries work without SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=quotes@example.com
INQUIRY_TO_EMAIL=quotes@example.com
INQUIRY_EMAIL_VERIFIED=false
# The public email address is edited separately in Django admin > Site settings.
PUBLIC_EMAIL_VERIFIED=false
